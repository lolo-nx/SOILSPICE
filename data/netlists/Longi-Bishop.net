V1 N097 0 V
D1 0 N027 RF2001NS2D
D2 N027 N062 RF2001NS2D
D3 N062 N097 RF2001NS2D

* block symbol definitions
.subckt pvcell-longi + -
I1 - N {I1*(1 - f_cov*(1 - tau_I))}
D1 N - 1N914
R1 N - {rp}
R2 N + {rs}
B1 N - I=V(N,-)/{rp}*{a}*pwr(1-V(N,-)/{Vb},-{b})
.model 1N914 D IS={IS1} N={n1} TNOM={t}
.param IS1  = 1.702211e-12 ; 4.875715e-14
.param Isc  = 7.20214        ; A / demi-cellule
.param kc   = 0.0005         ; current temp coef
.param t=25.0
.param kv   = -0.00210         ; voltage temp coef
.param n1   = 1
.param Vi   = 1000
.param rp   =  5.5438
.param rs   =0.001948 ;  0.002702     ohm / demi-cellule
.param q    = 1.6e-19
.param k    = 1.3806e-23      ; constante de Boltzmann
.param I1   = (Isc+Isc*kc*(t-25))*(Vi/1000)
.param Vb=-4.5 a=2e-3 b=3
.param f_cov=0 tau_I=1
.ends pvcell-longi

.model D D
.lib /Users/lorrainenaux/Library/Application Support/LTspice/lib/cmp/standard.dio
.dc V1 42 0 0.2
.backanno
.end
