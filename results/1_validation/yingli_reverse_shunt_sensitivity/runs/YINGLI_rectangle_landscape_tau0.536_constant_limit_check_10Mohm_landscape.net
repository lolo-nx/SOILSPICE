V1 N001 0 V
D1 0 N002 RF2001NS2D
D2 N002 N003 RF2001NS2D
D3 N003 N001 RF2001NS2D

* block symbol definitions
.subckt pvcell_bishop + -
I1 - N001 {I1*(1 - f_cov*(1 - tau_I))}
Bsh N001 - I=if(V(N001,-)>=0,V(N001,-)/{rp},V(N001,-)/1e+07)
Rs + N001 {rs}
D1 N001 - 1N914
.model 1N914 D IS={IS} N={n1} TNOM={t}
.param IS= 6.994062e-10
.param n1=1.075
.param Isc=  9.1010
.param kc=0.0004
.param t=24.8
.param kv=-0.0031
.param Vi=1000
.param rp=5.99
.param rs=  0.00491
.param q=1.6e-19
.param k=1.3806e-23     ; constante de Boltzmann
.param I1=(Isc+Isc*kc*(t-25))*(Vi/1000)
.param f_cov=0
.param tau_I=1
.ends pvcell_bishop

.model D D
.lib /Users/lorrainenaux/Library/Application Support/LTspice/lib/cmp/standard.dio
.dc V1 0 39.5 0.05
.backanno
.save I(V1) I(D1) I(D2) I(D3) V(N052) V(x20:N001) I(x20:Bsh) I(x20:D1) I(x20:I1) I(x20:Rs) V(N046) V(x19:N001) I(x19:Bsh) I(x19:D1) I(x19:I1) I(x19:Rs) V(N040) V(x18:N001) I(x18:Bsh) I(x18:D1) I(x18:I1) I(x18:Rs) V(N034) V(x17:N001) I(x17:Bsh) I(x17:D1) I(x17:I1) I(x17:Rs) V(N028) V(x16:N001) I(x16:Bsh) I(x16:D1) I(x16:I1) I(x16:Rs) V(N022) V(x15:N001) I(x15:Bsh) I(x15:D1) I(x15:I1) I(x15:Rs) V(N016) V(x14:N001) I(x14:Bsh) I(x14:D1) I(x14:I1) I(x14:Rs) V(N010) V(x13:N001) I(x13:Bsh) I(x13:D1) I(x13:I1) I(x13:Rs) V(N004) V(x12:N001) I(x12:Bsh) I(x12:D1) I(x12:I1) I(x12:Rs) V(x11:N001) I(x11:Bsh) I(x11:D1) I(x11:I1) I(x11:Rs)
