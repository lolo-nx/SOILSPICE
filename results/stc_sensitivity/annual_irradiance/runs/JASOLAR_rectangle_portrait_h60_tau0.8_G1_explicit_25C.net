* block symbol definitions
.subckt pvcell_jasolar + -
I1 - N001 {I1*(1 - f_cov*(1 - tau_I))}
D1 N001 - D1
R1 N001 - {rp}
R2 N001 + {rs}
.model D1 D(IS={IS1} N={n1} TNOM={t})
.param IS1  = 1.007337e-11    ; A / demi-cellule
.param Isc  = 6.559548        ; A / demi-cellule
.param kc   = 0.0004          ; current temp coef
.param t=25.0
.param kv   = -0.0026         ; voltage temp coef
.param n1   = 1.05706
.param Vi=1
.param rp   =  12.639089
.param rs   = 0.003872        ; ohm / demi-cellule
.param q    = 1.6e-19
.param k    = 1.3806e-23      ; constante de Boltzmann
.param I1   = (Isc+Isc*kc*(t-25))*(Vi/1000)
.param f_cov=0
.param tau_I=1
.ends pvcell_jasolar

.model D D
.lib "C:\Users\naux\AppData\Local\LTspice\lib\cmp\standard.dio"
.dc V1 0 47.16 0.02
.backanno
.temp 25
.save I(V1) I(D1) I(D2) I(D3) V(N097) V(N027) V(N062)
.end
