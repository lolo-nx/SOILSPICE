D1 0 N002 RF2001NS2D
D2 N002 N003 RF2001NS2D
D3 N003 N001 RF2001NS2D
V1 N001 0 0
* block symbol definitions
.subckt pvcell-sunpower-bishop + -
I1 - N {I1*(1 - f_cov*(1 - tau_I))}
R1 N - {rp}
R2 N + {rs}
D1 N - 1N914
B1 N - I=V(N,-)/{rp}*{a}*pwr(1-V(N,-)/{Vb},-{b})
.model 1N914 D IS={IS1} N={n1} TNOM={t}
.param IS1= 3.239880e-10
.param n1=1.1797
.param Isc= 6.1406
.param kc=0.000472
.param t=25.0 ; 24.7
.param kv=-0.002455
.param Vi=800
.param rp=5.51
.param rs=0.00168
.param q=1.6e-19
.param k=1.3806e-23     ; constante de Boltzmann
.param I1=(Isc+Isc*kc*(t-25))*(Vi/1000)
.param Vb=-3 a=2e-3 b=3
.param f_cov=0
.param tau_I=1
.ends pvcell-sunpower-bishop

.model D D
.lib "C:\Users\naux\AppData\Local\LTspice\lib\cmp\standard.dio"
.dc V1 78.78 0 -0.02
.backanno
.temp 25
.save I(V1) I(D1) I(D2) I(D3) V(N001) V(N002) V(N003)
.end
